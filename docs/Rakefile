# frozen_string_literal: true

require "html-proofer"

desc "Build the Jekyll website"
task :build do
  sh "bundle exec jekyll build --trace"
end

desc "Validate internal links in the generated website"
task :check_links do
  HTMLProofer.check_directory(
    "./_site",
    checks: ["Links"],
    disable_external: true,
    # Generated URLs include the GitHub Pages baseurl, but _site is the local root.
    # Keep this prefix aligned with baseurl in _config.yml.
    swap_urls: {
      %r{\A/KnowledgeGarden/} => "/"
    }
  ).run
end

desc "Build the website and validate internal links"
task verify: [:build, :check_links]



desc "Build the Jekyll website for preview deployment"
task :build_preview do
  # Apply the preview config last to override the baseurl for root-hosted previews.
  sh "bundle exec jekyll build --config _config.yml,_config_preview.yml --trace"
end
